function generateAwbForSelectedRow() { var ui = (function () { try { return SpreadsheetApp.getUi(); } catch (e) { return { testMode: true, alert: function (m) { console.log(m); } }; } })(), sh = SpreadsheetApp.getActiveSheet(); if (ui.testMode) { sh = SpreadsheetApp.getActive().getSheetByName(TABS.web); } if (sh.getName() !== TABS.web) { ui.alert('Open the Web_Bookings tab and click a booking row first.'); return; } var row = ui.testMode ? sh.getLastRow() : sh.getActiveRange().getRow(); if (row < 2) { ui.alert('Click a booking row first (not the header).'); return; } var v = sh.getRange(row, 1, 1, 34).getValues()[0]; var notes = String(v[33] || ''), xm = notes.match(/EXTRAS REQUESTED: (.*?)(?: \(confirm| \||$)/); var d = { ref: v[0], date: Utilities.formatDate(new Date(), 'Asia/Jakarta', 'd MMM yyyy'), product: v[3], country: v[5], pieces: Number(v[6]) || 1, kg: v[7], dims: v[8], chg: v[9], contents: String(v[10]).replace(/ \| Options: .*$/, ''), declared: v[11], sh_name: v[12], sh_company: v[13], sh_phone: String(v[15]).replace(/^'/, ''), pickup_address: v[17], cn_name: v[22], cn_company: v[23], cn_address: v[24], cn_city: v[25], cn_postcode: v[26], cn_phone: v[27], extras: xm ? xm[1] : '' }; var qrBlob = UrlFetchApp.fetch('https://api.qrserver.com/v1/create-qr-code/?size=240x240&margin=0&data=' + encodeURIComponent('https://pcwfreight.com/track?ref=' + d.ref)).getBlob(); var qr = Utilities.base64Encode(qrBlob.getBytes()), html = ''; for (var k = 1; k <= d.pieces; k++) html += awbPageHtml_(d, k, d.pieces, qr); var pdf = Utilities.newBlob('<html><body style="margin:0">' + html + '</body></html>', 'text/html').getAs('application/pdf').setName('AWB_' + d.ref + '.pdf'); sendMail_({ to: settings_().Notify_Email, subject: 'AWB ' + d.ref, body: 'AWB PDF attached for ' + d.ref + '. Print on A4 and attach on top of each box.', attachments: [pdf] }); ui.alert('AWB emailed to the PCW notification address: ' + d.ref); }

