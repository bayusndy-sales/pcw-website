function pHash_(salt, code) { return Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, salt + '|' + code)); }
function pUser_(email) { const sh = sh_('Portal_Users'); const v = sh.getDataRange().getValues(); for (let i = 1; i < v.length; i++) { if (String(v[i][0]).trim().toLowerCase() === email) return { row: i + 1, sh: sh, email: email, company: String(v[i][1]), name: String(v[i][2]), salt: String(v[i][3]), hash: String(v[i][4]), status: String(v[i][5]), rate: String(v[i][6]) }; } return null; }
function pSession_(token) { const em = CacheService.getScriptCache().get('ps_' + String(token || '')); return em ? pUser_(em) : null; }
function portalInvite() { const sh = sh_('Portal_Users'); const v = sh.getDataRange().getValues(); const al = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; let out = []; for (let i = 1; i < v.length; i++) { const em = String(v[i][0]).trim().toLowerCase(); if (!em || String(v[i][5]) !== 'Invite') continue; let code = ''; for (let k = 0; k < 12; k++) code += al.charAt(Math.floor(Math.random() * al.length)); const salt = Utilities.getUuid(); sh.getRange(i + 1, 4, 1, 3).setValues([[salt, pHash_(salt, code), 'Active']]); sh.getRange(i + 1, 8).setValue(new Date()); out.push(em + '  code: ' + code); } if (out.length) MailApp.sendEmail({ to: settings_().Notify_Email, subject: 'PCW portal access codes', body: 'Send each code to the customer on a separate message from the login page link https://pcwfreight.com/portal\n\n' + out.join('\n') }); return out.length; }
function portalLogin_(b) { const em = String(b.email || '').trim().toLowerCase(); if (!em || !rateLimit_('pl_' + em, 8, 900)) return { ok: false, error: 'invalid_login' }; const u = pUser_(em); if (!u || u.status !== 'Active' || !u.salt || pHash_(u.salt, String(b.code || '').trim().toUpperCase()) !== u.hash) return { ok: false, error: 'invalid_login' }; const token = Utilities.getUuid().replace(/-/g, '') + Utilities.getUuid().replace(/-/g, ''); CacheService.getScriptCache().put('ps_' + token, em, 21600); u.sh.getRange(u.row, 9).setValue(new Date()); return { ok: true, token: token, company: u.company, name: u.name, email: em }; }
function portalList_(b) { const u = pSession_(b.token); if (!u) return { ok: false, error: 'session' }; const sh = sh_(TABS.web); const last = sh.getLastRow(); const rows = last < 2 ? [] : sh.getRange(2, 1, last - 1, 34).getValues(); const mine = rows.filter(function (r) { return String(r[14]).trim().toLowerCase() === u.email; }).reverse().slice(0, 40); const st = {}; sh_(TABS.track).getDataRange().getValues().slice(1).forEach(function (r) { if (r[2] && r[0]) { const t = r[1] instanceof Date ? r[1].getTime() : 0; const k = String(r[0]).toUpperCase(); if (!st[k] || t >= st[k].t) st[k] = { t: t, s: String(r[2]) }; } }); const map = {}; sh_(TABS.status).getDataRange().getValues().slice(1).forEach(function (r) { if (r[0]) map[r[0]] = b.lang === 'id' ? r[2] : r[1]; }); return { ok: true, company: u.company, items: mine.map(function (r) { const k = String(r[0]).toUpperCase(); const raw = st[k] ? st[k].s : 'Booking request'; return { ref: r[0], date: r[1] instanceof Date ? Utilities.formatDate(r[1], TZ, 'yyyy-MM-dd') : '', product: r[3], dest: r[5], pieces: r[6], kg: r[7], to: String(r[22]) + (r[23] ? ' / ' + r[23] : ''), contents: r[10], status: map[raw] || raw }; }) }; }
function portalBook_(b) { const u = pSession_(b.token); if (!u) return { ok: false, error: 'session' }; const x = {}; Object.keys(b).forEach(function (k) { x[k] = b[k]; }); delete x.token; x.action = 'book'; x.shipper_email = u.email; x.shipper_company = u.company; x.shipper_name = String(b.shipper_name || u.name || u.company); x.__member = true; const dm = String(u.rate || '').match(/^DISC(\d{1,2})$/); x.__disc = dm ? parseInt(dm[1], 10) / 100 : 0; return book_(x); }
