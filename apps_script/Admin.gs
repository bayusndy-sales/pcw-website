function adm_(b) { const u = sess_(b.token); return u && u.role === 'SuperAdmin' ? u : null; }
function audit_(u, action, detail) { try { sh_('Admin_Audit').appendRow([new Date(), u.email, action, safe_(detail, 300)]); } catch (e) { console.error(e); } }
function dt_(d) { return d instanceof Date ? Utilities.formatDate(d, TZ, 'yyyy-MM-dd HH:mm') : ''; }
function admUsers_(b) { if (!adm_(b)) return { ok: false, error: 'session' }; const v = sh_('Portal_Users').getDataRange().getValues().slice(1).filter(function (r) { return r[0]; }); return { ok: true, users: v.map(function (r) { return { email: String(r[0]), company: String(r[1]), name: String(r[2]), status: String(r[5]), rate: String(r[6]), created: dt_(r[7]), last: dt_(r[8]), role: String(r[10] || 'Customer'), phone: String(r[11] || '') }; }) }; }
function admUserSet_(b) { const a = adm_(b); if (!a) return { ok: false, error: 'session' }; const email = String(b.email || '').trim().toLowerCase(); const u = uGet_(email); if (!u) return { ok: false, error: 'not_found' }; const st = String(b.status || u.status); const rate = String(b.rate == null ? u.rate : b.rate).trim().toUpperCase(); if (['Pending', 'Active', 'Disabled', 'Invite'].indexOf(st) < 0 || !/^[A-Z0-9_]{0,20}$/.test(rate)) return { ok: false, error: 'invalid' }; if (email === a.email && st !== 'Active') return { ok: false, error: 'cannot_disable_self' }; if (/^DISC/.test(rate) && !/^DISC(\d{1,2})$/.test(rate)) return { ok: false, error: 'invalid' }; u.sh.getRange(u.row, 6, 1, 2).setValues([[st, rate]]); audit_(a, 'user_set', email + ' status=' + st + ' rate=' + rate); return { ok: true }; }
function admBookings_(b) { if (!adm_(b)) return { ok: false, error: 'session' }; const sh = sh_(TABS.web); const last = sh.getLastRow(); const rows = last < 2 ? [] : sh.getRange(2, 1, last - 1, 34).getValues(); const st = {}; sh_(TABS.track).getDataRange().getValues().slice(1).forEach(function (r) { if (r[0] && r[2]) { const t = r[1] instanceof Date ? r[1].getTime() : 0; const k = String(r[0]).toUpperCase(); if (!st[k] || t >= st[k].t) st[k] = { t: t, s: String(r[2]) }; } }); return { ok: true, items: rows.reverse().slice(0, 150).map(function (r) { const k = String(r[0]).toUpperCase(); return { ref: r[0], date: dt_(r[1]), product: r[3], dest: r[5], pieces: r[6], kg: r[7], chg: r[9], contents: r[10], shipper: String(r[12]) + (r[13] ? ' / ' + r[13] : ''), email: r[14], to: String(r[22]) + (r[23] ? ' / ' + r[23] : ''), est: r[29], notes: r[33], status: st[k] ? st[k].s : 'Booking request' }; }) }; }
function admStatus_(b) { const a = adm_(b); if (!a) return { ok: false, error: 'session' }; const ref = String(b.ref || '').trim().toUpperCase(); const names = sh_(TABS.status).getDataRange().getValues().slice(1).map(function (r) { return String(r[0]); }); const status = String(b.status || ''); if (!/^[A-Z0-9-]{6,40}$/.test(ref) || names.indexOf(status) < 0) return { ok: false, error: 'invalid' }; sh_(TABS.track).appendRow([ref, new Date(), status, safe_(b.location, 80), safe_(b.est, 20), safe_(b.note, 200), a.email]); audit_(a, 'status', ref + ' -> ' + status); return { ok: true }; }
function admStatuses_(b) { if (!adm_(b)) return { ok: false, error: 'session' }; return { ok: true, statuses: sh_(TABS.status).getDataRange().getValues().slice(1).map(function (r) { return String(r[0]); }).filter(String) }; }
function admRoute_(b) { switch (b.action) { case 'adm_users': return admUsers_(b); case 'adm_user_set': return admUserSet_(b); case 'adm_bookings': return admBookings_(b); case 'adm_status': return admStatus_(b); case 'adm_statuses': return admStatuses_(b); } return null; }
