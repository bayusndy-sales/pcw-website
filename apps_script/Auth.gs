function pRound_(salt, pw, ver) { let h = Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, salt + '|' + pw)); if (ver === 'v2') { for (let i = 0; i < 999; i++) h = Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, h + salt)); } return h; }
function uGet_(email) { const sh = sh_('Portal_Users'); const v = sh.getDataRange().getValues(); for (let i = 1; i < v.length; i++) { if (String(v[i][0]).trim().toLowerCase() === email) { const x = v[i]; return { row: i + 1, sh: sh, email: email, company: String(x[1]), name: String(x[2]), salt: String(x[3]), hash: String(x[4]), status: String(x[5]), rate: String(x[6]), role: String(x[10] || 'Customer'), phone: String(x[11] || ''), ver: String(x[12] || '') }; } } return null; }
function uPub_(u) { return { email: u.email, company: u.company, name: u.name, phone: u.phone, role: u.role, plan: u.rate ? 'member' : 'published' }; }
function num6_() { return ('000000' + Math.floor(Math.random() * 1000000)).slice(-6); }
function mailTo_(to, subject, body) { try { sendMail_({ to: to, subject: subject, body: body }); } catch (e) { console.error(e); } }
function emailOk_(e) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e); }
function setPw_(u, pw) { const salt = Utilities.getUuid(); u.sh.getRange(u.row, 4, 1, 2).setValues([[salt, pRound_(salt, pw, 'v2')]]); u.sh.getRange(u.row, 13).setValue('v2'); }
function sess_(token) { const c = CacheService.getScriptCache().get('ss_' + String(token || '')); if (!c) return null; const u = uGet_(JSON.parse(c).e); return u && u.status === 'Active' ? u : null; }
function issue_(u) { const token = Utilities.getUuid().replace(/-/g, '') + Utilities.getUuid().replace(/-/g, ''); const ttl = (u.role === 'SuperAdmin' || u.role === 'Ops') ? 7200 : 21600; const cache = CacheService.getScriptCache(); cache.put('ss_' + token, JSON.stringify({ e: u.email }), ttl); cache.put('ps_' + token, u.email, ttl); u.sh.getRange(u.row, 9).setValue(new Date()); return { ok: true, token: token, user: uPub_(u) }; }
function register_(b) { if (b.website) return { ok: false, error: 'rejected' }; if (!verifyTurnstile_(b.turnstile)) return { ok: false, error: 'bot_check_failed' }; const email = String(b.email || '').trim().toLowerCase(); const name = safe_(b.name, 80), company = safe_(b.company, 120), phone = normPhone_(b.phone); const pw = String(b.password || ''); if (!emailOk_(email) || !name || !company) return { ok: false, error: 'missing_fields' }; if (phone.length < 9 || phone.length > 15) return { ok: false, error: 'invalid_whatsapp' }; if (pw.length < 10 || pw.toLowerCase() === email) return { ok: false, error: 'weak_password' }; if (b.terms_accepted !== true || b.privacy_consent !== true) return { ok: false, error: 'consent_required' }; if (!rateLimit_('rg_' + email, 3, 3600) || !rateLimit_('rg_all', 40, 3600)) return { ok: false, error: 'too_many_requests' }; const lock = LockService.getScriptLock(); lock.waitLock(20000); try { const ex = uGet_(email); if (ex && ex.status !== 'Pending') { mailTo_(email, 'PCW Freight account', 'Someone tried to register this email at pcwfreight.com/register, but an account already exists. Sign in at https://pcwfreight.com/portal or use "Forgot password". If this was not you, ignore this email.'); return { ok: true }; } let u = ex; if (!u) { const salt = Utilities.getUuid(); sh_('Portal_Users').appendRow([email, company, name, salt, pRound_(salt, pw, 'v2'), 'Pending', '', new Date(), '', 'Self-registered', 'Customer', "'" + phone, 'v2']); } else { u.sh.getRange(u.row, 2, 1, 2).setValues([[company, name]]); setPw_(u, pw); } } finally { lock.releaseLock(); } const code = num6_(); CacheService.getScriptCache().put('vf_' + email, code, 1800); mailTo_(email, 'PCW Freight: your verification code ' + code, 'Your PCW Freight verification code is ' + code + ' (valid 30 minutes).\nKode verifikasi PCW Freight Anda: ' + code + ' (berlaku 30 menit).'); return { ok: true }; }
function verify_(b) { const email = String(b.email || '').trim().toLowerCase(); if (!rateLimit_('vt_' + email, 6, 1800)) return { ok: false, error: 'too_many_requests' }; const code = CacheService.getScriptCache().get('vf_' + email); const u = uGet_(email); if (!u || u.status !== 'Pending' || !code || code !== String(b.code || '').trim()) return { ok: false, error: 'invalid_code' }; u.sh.getRange(u.row, 6).setValue('Active'); CacheService.getScriptCache().remove('vf_' + email); mailTo_(settings_().Notify_Email, 'New PCW portal customer: ' + u.company, u.name + ' / ' + u.company + ' / ' + u.email + ' / ' + u.phone + '\nPlan: published rates. Set Rate_Profile in Portal_Users to change.'); return { ok: true }; }
function login_(b) { const email = String(b.email || '').trim().toLowerCase(); if (!email || !rateLimit_('pl_' + email, 8, 900) || !rateLimit_('pl_all', 300, 900)) return { ok: false, error: 'invalid_login' }; const u = uGet_(email); const pw = String(b.password || ''); if (!u || !u.salt || u.status !== 'Active') return { ok: false, error: 'invalid_login' }; const given = u.ver === 'v2' ? pw : pw.trim().toUpperCase(); if (pRound_(u.salt, given, u.ver) !== u.hash) return { ok: false, error: 'invalid_login' }; if (u.role === 'SuperAdmin' || u.role === 'Ops') { const otp = num6_(); CacheService.getScriptCache().put('ot_' + email, otp, 600); mailTo_(email, 'PCW admin sign-in code ' + otp, 'Your PCW admin sign-in code is ' + otp + ' (valid 10 minutes). If you did not try to sign in, change your password now.'); return { ok: true, otp: true }; } return issue_(u); }
function loginOtp_(b) { const email = String(b.email || '').trim().toLowerCase(); if (!rateLimit_('po_' + email, 6, 600)) return { ok: false, error: 'too_many_requests' }; const otp = CacheService.getScriptCache().get('ot_' + email); const u = uGet_(email); if (!u || (u.role !== 'SuperAdmin' && u.role !== 'Ops') || u.status !== 'Active' || !otp || otp !== String(b.code || '').trim()) return { ok: false, error: 'invalid_code' }; CacheService.getScriptCache().remove('ot_' + email); return issue_(u); }
function resetReq_(b) { const email = String(b.email || '').trim().toLowerCase(); if (!emailOk_(email) || !rateLimit_('rr_' + email, 3, 3600) || !rateLimit_('rr_all', 40, 3600)) return { ok: true }; const u = uGet_(email); if (u && u.status !== 'Disabled') { const code = num6_(); CacheService.getScriptCache().put('rs_' + email, code, 1800); mailTo_(email, 'PCW Freight: password reset code ' + code, 'Your PCW Freight password reset code is ' + code + ' (valid 30 minutes). If you did not ask for this, ignore this email.\nKode reset password PCW Freight Anda: ' + code + ' (berlaku 30 menit).'); } return { ok: true }; }
function resetDo_(b) { const email = String(b.email || '').trim().toLowerCase(); const pw = String(b.password || ''); if (!rateLimit_('rt_' + email, 6, 1800)) return { ok: false, error: 'too_many_requests' }; if (pw.length < 10 || pw.toLowerCase() === email) return { ok: false, error: 'weak_password' }; const code = CacheService.getScriptCache().get('rs_' + email); const u = uGet_(email); if (!u || u.status === 'Disabled' || !code || code !== String(b.code || '').trim()) return { ok: false, error: 'invalid_code' }; setPw_(u, pw); if (u.status !== 'Active') u.sh.getRange(u.row, 6).setValue('Active'); CacheService.getScriptCache().remove('rs_' + email); return { ok: true }; }
function me_(b) { const u = sess_(b.token); return u ? { ok: true, user: uPub_(u) } : { ok: false, error: 'session' }; }
function logout_(b) { const c = CacheService.getScriptCache(); c.remove('ss_' + b.token); c.remove('ps_' + b.token); return { ok: true }; }
function discOf_(u) { const m = String(u.rate || '').match(/^DISC(\d{1,2})$/); return m ? parseInt(m[1], 10) / 100 : 0; }
function rateMember_(b) { const u = sess_(b.token); if (!u) return { ok: false, error: 'session' }; const r = rate_({ country: b.country, type: b.type, kg: b.kg, pieces: b.pieces, l: b.l, w: b.w, h: b.h, items: b.items }); if (!r.ok) return r; const d = discOf_(u); const special = u.rate && !/^DISC/.test(u.rate) && u.rate !== 'PUBLISHED'; r.options = r.options.map(function (o) { if (o.quote) return o; if (special) return { product: o.product, chargeable_kg: o.chargeable_kg, quote: true }; if (d) return { product: o.product, chargeable_kg: o.chargeable_kg, base: Math.round(o.base * (1 - d)), demand: Math.round((o.demand || 0) * (1 - d)), fuel: Math.round(o.fuel * (1 - d)), total: Math.round(o.total * (1 - d)), not_cheaper: o.not_cheaper }; return o; }); r.plan = u.rate ? 'member' : 'published'; return r; }
function profile_(b) { const u = sess_(b.token); if (!u) return { ok: false, error: 'session' }; const name = safe_(b.name, 80), phone = normPhone_(b.phone); if (!name || phone.length < 9 || phone.length > 15) return { ok: false, error: 'missing_fields' }; u.sh.getRange(u.row, 3).setValue(name); u.sh.getRange(u.row, 12).setValue("'" + phone); return { ok: true }; }
function chpw_(b) { const u = sess_(b.token); if (!u) return { ok: false, error: 'session' }; if (!rateLimit_('cp_' + u.email, 6, 1800)) return { ok: false, error: 'too_many_requests' }; const cur = String(b.current || ''); if (pRound_(u.salt, u.ver === 'v2' ? cur : cur.trim().toUpperCase(), u.ver) !== u.hash) return { ok: false, error: 'invalid_login' }; const pw = String(b.password || ''); if (pw.length < 10 || pw.toLowerCase() === u.email) return { ok: false, error: 'weak_password' }; setPw_(u, pw); return { ok: true }; }
function bookAuth_(b) { const u = sess_(b.token); if (!u) return { ok: false, error: 'session' }; const x = {}; Object.keys(b).forEach(function (k) { x[k] = b[k]; }); delete x.token; x.action = 'book'; x.shipper_email = u.email; x.shipper_company = u.company; x.shipper_name = String(b.shipper_name || u.name || u.company); x.__member = true; x.__disc = discOf_(u); x.__pub = !u.rate || u.rate === 'PUBLISHED'; return book_(x); }
function authRoute_(b) { switch (b.action) { case 'register': return register_(b); case 'verify': return verify_(b); case 'login': return login_(b); case 'login_otp': return loginOtp_(b); case 'reset_req': return resetReq_(b); case 'reset_do': return resetDo_(b); case 'me': return me_(b); case 'rate_m': return rateMember_(b); case 'profile': return profile_(b); case 'chpw': return chpw_(b); case 'logout': return logout_(b); case 'book_m': return bookAuth_(b); case 'list_m': return portalList_(b); case 'awb_m': return awbGet_(b); } return null; }
